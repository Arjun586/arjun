# RESEND_API_KEY: Required for sending contact form emails via Resend to arjunofficial586@gmail.com.
# Add this in your Vercel Project Settings -> Environment Variables (or local .env).
RESEND_API_KEY="re_xxxxxxxxx"

# RESEND_FROM_EMAIL: Optional custom verified domain sender address.
# Defaults to "Portfolio Contact <onboarding@resend.dev>" which works out-of-the-box with arjunofficial586@gmail.com.
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
